node_modules/
.env
.env.local
.DS_Store

# generated at build/serve time
web/data/
web/config.js
web/preview-standalone.html
web/_headers

# NOTE: data/snapshots and data/derived ARE committed on purpose -
# the hourly job persists them so 24h/7d/14d deltas survive across runs.

# local editor/preview config
.claude/

# Cloudflare Worker local dev
worker/.dev.vars
worker/.wrangler/

# Collector output lives on the `data` branch, not here. main keeps only the
# hand-edited inputs (roster.json, priorities.json, overrides.json) so its
# history is code. To get a local copy for `npm run build:site`:
#   git fetch origin data && git checkout origin/data -- data
data/derived/
data/presence/
data/tracker-history.json
data/tracker-state.json
data/steam-history.json
data/last-known-hours.json
data/proxy-use.json
data/teams.json
