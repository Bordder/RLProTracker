node_modules/
.env
.env.local
.DS_Store

# generated at build/serve time
web/data/
web/config.js
web/preview-standalone.html
web/_headers

# NOTE: data/snapshots and data/derived ARE committed on purpose -
# the hourly job persists them so 24h/7d/14d deltas survive across runs.

# local editor/preview config
.claude/

# Cloudflare Worker local dev
worker/.dev.vars
worker/.wrangler/

# wrangler's own scratch at the repo root. `wrangler pages deploy` bundles
# functions/ into a single worker here and leaves it behind, ~1700 generated
# lines under a randomly suffixed name, so a new one appears after every deploy.
/.wrangler/

# Collector output lives on the `data` branch, not here. main keeps only the
# hand-edited inputs (roster.json, priorities.json, overrides.json) so its
# history is code. To get a local copy for `npm run build:site`:
#   git fetch origin data && git checkout origin/data -- data
data/derived/
data/presence/
data/tracker-history.json
data/tracker-state.json
data/steam-history.json
data/last-known-hours.json
data/proxy-use.json

# Bracket page, built out of tree on purpose (9 Sept 2026). Nothing in here is
# committed, pushed or deployed: anything under web/ ships on the next
# `wrangler pages deploy`, and a half-finished bracket must not be publicly
# reachable at a guessable URL while the main site is being shipped. Move files
# into scripts/ and web/ deliberately, in their own commit, when the page is
# wanted live.
rlcs-bracket/

# Written by build:site so the deployed build can be compared against main.
# Generated per deploy, never committed.
web/build.json

# Proxy endpoints and credentials, for running scripts/proxyProbe.mjs or
# scripts/checkProxies.mjs locally. NEVER commit these: this repo is public, and
# the list is the whole fleet. The collector reads them from the PROXY_LIST
# secret in Actions, never from a file.
proxies.txt
proxies*.txt
proxy-list*.txt
*.proxies
proxies.json
proxy-report*.txt

# Local-only tooling and its inputs. Anything under local/ is for this machine:
# proxy lists, ad-hoc scripts, scratch output. It is inside the repo so it is
# easy to find, and ignored so it can never be committed or deployed. wrangler
# only uploads web/, so nothing here ships either.
/local/
