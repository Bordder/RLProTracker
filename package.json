{
  "name": "rl-pro-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Dashboard of professional Rocket League players' ranked statistics and playtime",
  "scripts": {
    "fetch:roster": "node scripts/fetchRoster.mjs",
    "fetch:steam": "node scripts/fetchSteam.mjs",
    "snapshot": "node scripts/fetchSteam.mjs",
    "deltas": "node scripts/computeDeltas.mjs",
    "aggregate": "node scripts/aggregate.mjs",
    "poll": "node scripts/pollPresence.mjs",
    "poll:hours": "node scripts/computePresenceHours.mjs",
    "fetch:tracker": "node scripts/fetchTracker.mjs",
    "tracker:deltas": "node scripts/computeTrackerDeltas.mjs",
    "tracker:aggregate": "node scripts/aggregateTracker.mjs",
    "presence:hot": "node scripts/presenceHot.mjs",
    "tracker": "node scripts/presenceHot.mjs && node scripts/fetchTracker.mjs && node scripts/computeTrackerDeltas.mjs && node scripts/aggregateTracker.mjs && node scripts/recordUptime.mjs",
    "build:site": "node scripts/buildSite.mjs",
    "update": "node scripts/fetchSteam.mjs && node scripts/computeDeltas.mjs && node scripts/aggregate.mjs",
    "test": "node --test",
    "uptime": "node scripts/recordUptime.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
